10 REM CLINTER V1.0 - NEBULA GRAPHICS DEMO
20 REM MSX2 SCREEN 5 - 256 X 212
30 SCREEN 5
40 COLOR 15,1,1
50 CLS
60 REM BACKGROUND STAR FIELD
70 FOR I=1 TO 220
80 X=INT(RND(1)*256)
90 Y=INT(RND(1)*212)
100 C=7+INT(RND(1)*9)
110 PSET (X,Y),C
120 NEXT I
130 REM THREE OVERLAPPING NEBULA CLOUDS
140 FOR I=1 TO 1700
150 A=RND(1)*6.2831853
160 R=RND(1)+RND(1)+RND(1)+RND(1)
170 X=INT(125+COS(A)*R*22)
180 Y=INT(106+SIN(A)*R*12)
190 IF X<0 OR X>255 OR Y<0 OR Y>211 THEN 220
200 C=4+INT(RND(1)*3)
210 PSET (X,Y),C
220 NEXT I
230 FOR I=1 TO 1100
240 A=RND(1)*6.2831853
250 R=RND(1)+RND(1)+RND(1)
260 X=INT(91+COS(A)*R*19)
270 Y=INT(96+SIN(A)*R*15)
280 IF X<0 OR X>255 OR Y<0 OR Y>211 THEN 310
290 C=8+INT(RND(1)*3)
300 PSET (X,Y),C
310 NEXT I
320 FOR I=1 TO 900
330 A=RND(1)*6.2831853
340 R=RND(1)+RND(1)+RND(1)
350 X=INT(161+COS(A)*R*18)
360 Y=INT(118+SIN(A)*R*14)
370 IF X<0 OR X>255 OR Y<0 OR Y>211 THEN 400
380 C=12+INT(RND(1)*3)
390 PSET (X,Y),C
400 NEXT I
410 REM BRIGHT STARS AND HALOS
420 FOR I=1 TO 16
430 X=10+INT(RND(1)*236)
440 Y=10+INT(RND(1)*192)
450 CIRCLE (X,Y),2,7
460 PSET (X,Y),15
470 NEXT I
480 REM KEEP GRAPHICS VISIBLE UNTIL USER EXITS
490 INPUT "Press Enter to exit..."; A$
500 SCREEN 0
510 END
