10 REM MSX2 G3: SCREEN 6 / 8 and page behavior
20 SCREEN 6
30 PSET (500,200),3
40 IF POINT(500,200)<>3 THEN PRINT "FAIL SCREEN6": END
50 SCREEN 6,,,1,0
60 PSET (30,30),2
70 IF POINT(30,30)<>2 THEN PRINT "FAIL SCREEN6 PAGE": END
80 SCREEN 6,,,0,1
90 IF POINT(30,30)<>0 THEN PRINT "FAIL PAGE ISOLATION": END
100 SCREEN 8
110 PSET (200,100),255
120 IF POINT(200,100)<>255 THEN PRINT "FAIL SCREEN8 255": END
130 LINE (10,10)-(20,20),224,BF
140 IF POINT(15,15)<>224 THEN PRINT "FAIL SCREEN8 LINE": END
150 PRINT "GRAPHICS G3 PASS"
160 INPUT "Press any key to continue..."; A$
170 END
