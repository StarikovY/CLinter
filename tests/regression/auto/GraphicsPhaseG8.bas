10 REM G8: extended MSX2 modes, pages and palette
20 SCREEN 6
30 COLOR 3,0
40 CLS
50 PSET (511,211),2
60 IF POINT(511,211)<>2 THEN PRINT "FAIL G8 SCREEN6 WIDTH": END
70 SCREEN 6,,,3,0
80 IF POINT(511,211)<>0 THEN PRINT "FAIL G8 SCREEN6 PAGE": END
90 PSET (511,211),3
100 SCREEN 6,,,0,3
110 IF POINT(511,211)<>2 THEN PRINT "FAIL G8 SCREEN6 PRESERVE": END
120 SCREEN 7
130 COLOR 15,0
140 PSET (511,211),12
150 SCREEN 7,,,1,0
160 IF POINT(511,211)<>0 THEN PRINT "FAIL G8 SCREEN7 PAGE": END
170 SCREEN 7,,,0,1
180 IF POINT(511,211)<>12 THEN PRINT "FAIL G8 SCREEN7 PRESERVE": END
190 SCREEN 8
200 COLOR 255,0
210 PSET (255,211),227
220 IF POINT(255,211)<>227 THEN PRINT "FAIL G8 SCREEN8 COLOR": END
230 PSET (0,0),31
240 IF POINT(0,0)<>31 THEN PRINT "FAIL G8 SCREEN8 LOW COLOR": END
250 IF POINT(255,211)<>227 THEN PRINT "FAIL G8 SCREEN8 PRESERVE": END
280 COLOR 255,0
290 CLS
300 LINE (0,0)-(255,211),227
310 CIRCLE (128,106),60,31
320 LOCATE 0,15
330 PRINT "GRAPHICS G8 PASS"
340 INPUT "Press any key to continue..."; A$
350 END
