10 REM MAT REGRESSION - ZERO-BASED ARRAYS
20 DIM A(2,2),B(2,2),C(2,2),D(2,2),E(2,2),F(2,2),V(3)
30 MAT A=IDN
40 MAT B=CON
50 MAT C=A+B
60 IF C(0,0)<>2 THEN PRINT "FAIL ADD":END
70 IF C(0,1)<>1 THEN PRINT "FAIL ADD OFFDIAG":END
80 MAT D=C-B
90 IF D(1,1)<>1 THEN PRINT "FAIL SUB":END
100 MAT E=C*D
110 IF E(0,0)<>2 THEN PRINT "FAIL MULT":END
120 MAT F=TRN(C)
130 IF F(1,0)<>1 THEN PRINT "FAIL TRANSPOSE":END
140 MAT F=INV(C)
150 MAT E=C*F
160 IF ABS(E(0,0)-1)>.00001 THEN PRINT "FAIL INV":END
170 IF ABS(E(0,1))>.00001 THEN PRINT "FAIL INV OFFDIAG":END
180 MAT V=ZER
190 IF V(2)<>0 THEN PRINT "FAIL ZERO":END
200 MAT V=CON
210 IF V(2)<>1 THEN PRINT "FAIL ONE":END
220 MAT D=A
230 MAT D=A*3
240 IF D(0,0)<>3 THEN PRINT "FAIL SCALAR":END
250 PRINT "MAT PASS"
260 END
