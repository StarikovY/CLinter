10 REM G4: palette, SCREEN 3/4 and DRAW M coordinates
20 SCREEN 5
30 COLOR=(2,7,0,0)
40 COLOR=(3,0,7,0)
50 LINE (10,10)-(80,60),2,BF
60 DRAW "BM10,80R20D20L20U20"
70 IF POINT(30,80)<>15 THEN PRINT "FAIL DRAW": END
80 DRAW "BM+10,+10R5"
90 IF POINT(25,90)<>15 THEN PRINT "FAIL RELATIVE DRAW": END
100 SCREEN 3
110 PSET (40,40),4
120 IF POINT(40,40)<>4 THEN PRINT "FAIL SCREEN3": END
130 SCREEN 4
140 PSET (60,60),6
150 IF POINT(60,60)<>6 THEN PRINT "FAIL SCREEN4": END
160 SCREEN 5
170 COLOR=(2,7,0,0)
180 COLOR=(3,0,7,0)
190 LINE (10,10)-(100,80),2,BF
200 CIRCLE (140,80),40,3
210 PRINT "GRAPHICS G4 PASS"
220 INPUT "Press any key to continue..."; A$
230 END
