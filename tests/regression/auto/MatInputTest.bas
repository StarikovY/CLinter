10 REM MAT INPUT - VALUES PROVIDED BY TEST RUNNER VIA STDIN
20 DIM A(2,2),B(2)
30 MAT INPUT A,B
40 IF A(0,0)<>11 THEN PRINT "FAIL MAT INPUT A00":END
50 IF A(0,1)<>12 THEN PRINT "FAIL MAT INPUT A01":END
60 IF A(1,0)<>21 THEN PRINT "FAIL MAT INPUT A10":END
70 IF A(1,1)<>22 THEN PRINT "FAIL MAT INPUT A11":END
80 IF B(0)<>31 THEN PRINT "FAIL MAT INPUT B0":END
90 IF B(1)<>32 THEN PRINT "FAIL MAT INPUT B1":END
100 PRINT "MAT INPUT PASS"
110 END
