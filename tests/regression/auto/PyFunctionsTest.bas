10 REM PYLINTER STAGE 1 NUMERIC AND STRING COMPATIBILITY
20 RANDOMIZE 12345
30 A=RND()
40 RANDOMIZE 12345
50 B=RND()
60 IF A<>B THEN PRINT "FAIL SEED":END
70 IF A<0 OR A>=1 THEN PRINT "FAIL RND RANGE":END
80 C=RNDINT(2,4)
90 IF C<2 OR C>4 THEN PRINT "FAIL RNDINT":END
100 IF ROUND(1.56,1)<>1.6 THEN PRINT "FAIL ROUND":END
110 IF ROUND(-1.5)<>-2 THEN PRINT "FAIL ROUND NEG":END
120 IF MAX(2,9,4)<>9 THEN PRINT "FAIL MAX":END
130 IF MIN(2,9,4)<>2 THEN PRINT "FAIL MIN":END
140 IF IFF(1,11,22)<>11 THEN PRINT "FAIL IFF TRUE":END
150 IF IFF(0,11,22)<>22 THEN PRINT "FAIL IFF FALSE":END
160 IF 17%5<>2 THEN PRINT "FAIL MODULO":END
170 IF MOD(17,5)<>2 THEN PRINT "FAIL MOD":END
180 A$=IF$(1,"YES","NO")
190 IF A$<>"YES" THEN PRINT "FAIL IF$ TRUE":END
200 A$=IF$(0,"YES","NO")
210 IF A$<>"NO" THEN PRINT "FAIL IF$ FALSE":END
220 PRINT "PYFUNCTIONS PASS"
230 END
