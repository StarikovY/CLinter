10 REM ========================================
20 REM CLINTER - RAINBOW SPIRAL DEMO
30 REM SCREEN 20 - 1280 X 720
40 REM TEST 1 - NO SCREEN 0
50 REM ========================================
60 SCREEN 20,3
70 COLOR 255,0
80 CLS
90 FOR I=0 TO 360
100 R=I/2.7
110 X=INT(640+R*COS(I))
120 Y=INT(360+R*SIN(I))
130 C=INT(I*255/360)
140 CR=INT(I/40)
150 CIRCLE (X,Y),CR,C
160 NEXT I
170 LOCATE 2,2
180 PRINT "RAINBOW SPIRAL - PRESS ENTER TO EXIT"
190 K$=INKEY$
200 IF K$="" THEN PAUSE .05:GOTO 190
210 END
