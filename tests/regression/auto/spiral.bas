100 REM ========================================
110 REM CLINTER - RAINBOW SPIRAL DEMO
120 REM SCREEN 20 - 1280 X 720
130 REM TEST 1 - NO SCREEN 0
140 REM ========================================
150 SCREEN 20,3
160 COLOR 255,0
170 CLS
180 FOR I=0 TO 360
190 R=I/2.7
200 X=640+R*COS(I)
210 Y=360+R*SIN(I)
220 c=I*255/360
230 CR=I/40
240 CIRCLE (X,Y),CR,C
250 NEXT I
260 LOCATE 2,2
270 PRINT "RAINBOW SPIRAL - PRESS ENTER TO EXIT"
280 K$=INKEY$
290 IF K$="" THEN PAUSE .05:GOTO 280
300 END
