10 REM P7 cross-subsystem FLOAT regression
20 DIM A(81,45),B(2,2),C(2,2),D$(2)
30 DATA 1.2345678901234567,2.51,.1
40 READ V,I,H
50 A(80.51,44.51)=V:D$(I-1)="OK"
60 IF A(81,45)<>V OR D$(2)<>"OK" THEN 900
70 B(0,0)=H:B(1,1)=H*2
80 MAT C=B*2.5
90 IF ABS(C(0,0)-.25)>1E-12 OR ABS(C(1,1)-.5)>1E-12 THEN 900
100 N=0:FOR T=0 TO .3 STEP H
110 N=N+1:A(I,T)=T
120 NEXT T
130 IF N<>4 OR ABS(A(3,0)-.3)>1E-12 THEN 900
140 Q%=I:IF Q%<>2 THEN 900
150 SCREEN 20
160 COLOR 15,0:CLS
170 X=100+C(1,1):Y=200+I
180 PSET (X,Y),7
190 IF POINT(101,203)<>7 OR POINT(100,202)<>0 THEN 900
200 LINE (X,Y)-STEP (I,0),9
210 IF POINT(104,203)<>9 THEN 900
220 LOCATE 2,2:PRINT "FLOAT INTEGRATION PASS"
230 INPUT "Press Enter to exit..."; Z$
240 SCREEN 0
250 END
900 PRINT "FLOAT INTEGRATION FAIL"
910 END
