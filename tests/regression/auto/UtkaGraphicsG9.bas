10 REM UTKA 1987 - SPRITE EDITION, SCREEN 7
20 REM I = FIRE, X = EXIT. CLICK GRAPHICS WINDOW FOR KEYBOARD FOCUS.
30 SCREEN 7,2
40 COLOR 15,1
50 CLS
60 REM SPRITE SIZE 8X8 MAGNIFIED TO 16X16
70 SPRITE$(0)=" <~~~|< "
80 SPRITE$(1)="  @@  @ "
90 SH=0: HIT=0: SCORE=0: B=0: BX=256: BY=185
100 X=20: Y=110: DX=6: T=0
110 GOSUB 8000
120 PUT SPRITE 0,(X,Y),10,0
130 PLAY "T180 O5 L8 C E G", "O4 L4 C G", "O3 L2 C"
140 REM LIVE GAME LOOP: FAST SPRITE MOVEMENT, NO FRAMEBUFFER ERASING
150 T=T+1
160 K$=INKEY$
170 IF K$="X" OR K$="x" THEN GOTO 7000
180 IF K$="I" OR K$="i" OR K$=" " THEN GOSUB 6000
190 X=X+DX
200 IF X>480 THEN DX=-6
210 IF X<12 THEN DX=6
220 IF T<70 THEN Y=112
230 IF T>=70 AND T<100 THEN Y=112-(T-70)*2
240 IF T>=100 AND T<220 THEN Y=52
250 IF T>=220 AND T<250 THEN Y=52+(T-220)*2
260 IF T>=250 THEN Y=112
270 PUT SPRITE 0,(X,Y),10,0
280 IF B=1 THEN GOSUB 5000
290 PAUSE .012
295 IF T>=300 THEN T=0
300 GOTO 150
5000 REM BULLET: MOVE UP AND CHECK DUCK COLLISION
5010 BY=BY-12
5020 IF BY<42 THEN B=0: PUT SPRITE 1: RETURN
5030 PUT SPRITE 1,(BX,BY),15,1
5040 IF BX>=X-5 AND BX<=X+19 AND BY>=Y-5 AND BY<=Y+19 THEN GOSUB 6500
5050 RETURN
6000 REM SHOOT IMMEDIATELY; ONE BULLET IN FLIGHT
6010 IF B=1 THEN RETURN
6020 SH=SH+1: B=1: BX=256: BY=184
6030 PUT SPRITE 1,(BX,BY),15,1
6040 BEEP
6050 RETURN
6500 REM HIT: DUCK FALLS AND QUACKS, THEN A NEW DUCK APPEARS
6510 B=0: HIT=HIT+1: SCORE=SCORE+100
6520 PUT SPRITE 1
6530 REM SHORT DESCENDING PSG EFFECT: SYNTHETIC "KRYA"
6540 PLAY "T220 O4 L16 G F D O3 B G", "T220 O3 L16 C R G R C"
6550 FY=Y: FX=X
6560 FOR F=1 TO 18
6570 FY=FY+6: FX=FX+DX/6
6580 IF FY>126 THEN FY=126
6590 IF FX<4 THEN FX=4
6600 IF FX>490 THEN FX=490
6610 PUT SPRITE 0,(FX,FY),10,0
6620 PAUSE .035
6630 IF FY>=126 THEN GOTO 6660
6640 NEXT F
6660 PUT SPRITE 0
6670 X=20: Y=112: DX=6: T=0
6680 PUT SPRITE 0,(X,Y),10,0
6690 RETURN
7000 REM HUNTER LEAVES: SHOW FINAL GAME STATISTICS
7010 PUT SPRITE 0
7020 PUT SPRITE 1
7030 CLS
7040 LOCATE 2,2
7050 PRINT "UTKA 1987 - HUNT FINISHED"
7060 LOCATE 2,5
7070 PRINT "SHOTS FIRED:"; SH
7080 LOCATE 2,7
7090 PRINT "DUCKS HIT: "; HIT
7100 LOCATE 2,9
7110 PRINT "SCORE:     "; SCORE
7120 LOCATE 2,13
7130 PRINT "PRESS ENTER OR ANY KEY TO LEAVE"
7140 K$=INKEY$
7150 IF K$<>"" THEN GOTO 7140
7160 K$=INKEY$
7170 IF K$="" THEN PAUSE .05: GOTO 7160
7180 END
8000 REM STATIC SCENE, SMALL HUNTER, NO DECORATIVE RING
8010 LINE (0,0)-(511,211),1,BF
8020 LINE (0,142)-(511,211),4,BF
8030 LINE (0,142)-(511,143),9
8040 LINE (0,180)-(511,180),9
8050 REM SMALL HUNTER 18X25, GUN CENTER
8060 LINE (247,194)-(265,211),6,BF
8070 CIRCLE (256,189),5,10
8080 LINE (253,181)-(259,184),6,BF
8090 LINE (255,173)-(257,190),15,BF
8100 LOCATE 1,0
8110 PRINT "UTKA 1987   SCREEN 7"
8120 LOCATE 1,1
8130 PRINT "I: FIRE   X: EXIT   CLICK WINDOW"
8140 RETURN
