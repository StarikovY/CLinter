10 REM CLINTER LIFE 720P - CONWAY GAME OF LIFE (1970)
20 REM SCREEN 20 / 1280X720 / 256 COLORS
30 REM 1 GLIDER  2 R-PENTOMINO  3 BLINKERS  4 GOSPER GUN
40 REM SPACE PAUSE  N SINGLE STEP  R RESET  +/- SPEED  X EXIT
50 SCREEN 20,3
60 COLOR 255,0
70 CLS
80 W=80:H=44:S=12:OX=160:OY=170
90 DIM A(81,45),B(81,45)
100 PAT=4:GEN=0:POP=0:DELAY=.12:HALT=0:STEPON=0
110 GOSUB 1000
120 REM MAIN LOOP
130 K$=INKEY$
140 IF K$="X" OR K$="x" OR ASC(K$)=27 THEN GOTO 9000
150 IF K$=" " THEN HALT=1-HALT
160 IF K$="N" OR K$="n" THEN STEPON=1
170 IF K$="R" OR K$="r" THEN GOSUB 1000
180 IF K$="1" THEN PAT=1:GOSUB 1000
190 IF K$="2" THEN PAT=2:GOSUB 1000
200 IF K$="3" THEN PAT=3:GOSUB 1000
210 IF K$="4" THEN PAT=4:GOSUB 1000
220 IF K$="+" OR K$="=" THEN DELAY=DELAY/1.5
230 IF K$="-" THEN DELAY=DELAY*1.5
240 IF DELAY<.01 THEN DELAY=.01
250 IF DELAY>.8 THEN DELAY=.8
260 IF HALT=1 AND STEPON=0 THEN GOSUB 6000:PAUSE .04:GOTO 130
270 STEPON=0
280 GOSUB 3000
290 GOSUB 4000
300 GOSUB 6000
310 PAUSE DELAY
320 GOTO 130
1000 REM RESET WORLD AND LOAD PATTERN
1010 FOR Y=0 TO H+1
1020 FOR X=0 TO W+1
1030 A(X,Y)=0:B(X,Y)=0
1040 NEXT X
1050 NEXT Y
1060 GEN=0:POP=0:HALT=0:STEPON=0:DRAWNEXT=0
1070 CLS
1080 LINE (OX-1,OY-1)-(OX+W*S,OY+H*S),40,B
1090 IF PAT=1 THEN GOSUB 2000
1100 IF PAT=2 THEN GOSUB 2100
1110 IF PAT=3 THEN GOSUB 2200
1120 IF PAT=4 THEN GOSUB 2300
1130 FOR Y=1 TO H
1140 FOR X=1 TO W
1150 IF A(X,Y)=1 THEN POP=POP+1:GOSUB 5000
1160 NEXT X
1170 NEXT Y
1180 GOSUB 6000
1190 RETURN
2000 REM GLIDER - NEAR CENTER
2010 A(40,19)=1:A(41,20)=1:A(39,21)=1
2020 A(40,21)=1:A(41,21)=1
2030 RETURN
2100 REM R-PENTOMINO - 1103 GENERATIONS TO STABILITY
2110 A(40,20)=1:A(41,20)=1:A(39,21)=1
2120 A(40,21)=1:A(40,22)=1
2130 RETURN
2200 REM THREE BLINKERS
2210 FOR I=35 TO 37:A(I,17)=1:NEXT I
2220 FOR I=21 TO 23:A(44,I)=1:NEXT I
2230 FOR I=40 TO 42:A(I,28)=1:NEXT I
2240 RETURN
2300 REM GOSPER GLIDER GUN - 36 LIVE CELLS
2310 REM COORDINATES ARE OFFSET TO LEFT-MIDDLE OF WORLD
2320 A(3,18)=1:A(3,19)=1:A(4,18)=1:A(4,19)=1
2330 A(13,18)=1:A(13,19)=1:A(13,20)=1
2340 A(14,17)=1:A(14,21)=1
2350 A(15,16)=1:A(15,22)=1
2360 A(16,16)=1:A(16,22)=1
2370 A(17,19)=1
2380 A(18,17)=1:A(18,21)=1
2390 A(19,18)=1:A(19,19)=1:A(19,20)=1
2400 A(20,19)=1
2410 A(23,16)=1:A(23,17)=1:A(23,18)=1
2420 A(24,16)=1:A(24,17)=1:A(24,18)=1
2430 A(25,15)=1:A(25,19)=1
2440 A(27,14)=1:A(27,15)=1:A(27,19)=1:A(27,20)=1
2450 A(37,16)=1:A(37,17)=1:A(38,16)=1:A(38,17)=1
2460 RETURN
3000 REM NEXT GENERATION - FIXED DEAD BOUNDARY
3010 FOR Y=1 TO H
3020 FOR X=1 TO W
3030 N=A(X-1,Y-1)+A(X,Y-1)+A(X+1,Y-1)
3040 N=N+A(X-1,Y)+A(X+1,Y)
3050 N=N+A(X-1,Y+1)+A(X,Y+1)+A(X+1,Y+1)
3060 B(X,Y)=0
3070 IF N=3 THEN B(X,Y)=1
3080 IF N=2 AND A(X,Y)=1 THEN B(X,Y)=1
3090 NEXT X
3100 NEXT Y
3110 RETURN
4000 REM UPDATE ONLY CHANGED PIXELS
4010 POP=0:DRAWNEXT=1
4020 FOR Y=1 TO H
4030 FOR X=1 TO W
4040 IF A(X,Y)<>B(X,Y) THEN GOSUB 5000
4050 A(X,Y)=B(X,Y)
4060 POP=POP+A(X,Y)
4070 NEXT X
4080 NEXT Y
4090 GEN=GEN+1:DRAWNEXT=0
4100 RETURN
5000 REM DRAW ONE CELL: CURRENT B(X,Y) STATE
5010 PX=OX+(X-1)*S:PY=OY+(Y-1)*S
5020 C=0
5030 IF DRAWNEXT=0 AND A(X,Y)=1 THEN C=28
5040 IF DRAWNEXT=1 AND B(X,Y)=1 THEN C=28
5050 LINE (PX,PY)-(PX+S-2,PY+S-2),C,BF
5060 RETURN
6000 REM STATUS PANEL: ERASE TEXT REGION BEFORE PRINTING
6010 LINE (0,0)-(1279,92),0,BF
6020 LOCATE 2,1
6030 PRINT "CLINTER 720P  -  CONWAY'S GAME OF LIFE  (1970)"
6040 LOCATE 2,3
6050 PRINT "1 GLIDER  2 R-PENTOMINO  3 BLINKERS  4 GOSPER GUN"
6060 LOCATE 2,5
6070 PRINT "SPACE PAUSE  N STEP  R RESET  +/- SPEED  X/ESC EXIT"
6080 LOCATE 2,7
6090 PRINT "GENERATION:";GEN;"  POPULATION:";POP;"  PATTERN:";PAT
6100 LOCATE 2,9
6110 IF HALT=1 THEN PRINT "PAUSED" ELSE PRINT "RUNNING"
6120 RETURN
9000 REM CLEAN EXIT
9010 CLS
9020 LOCATE 2,2
9030 PRINT "CONWAY'S GAME OF LIFE - END"
9040 LOCATE 2,4
9050 PRINT "GENERATIONS:";GEN;"  FINAL POPULATION:";POP
9060 LOCATE 2,7
9070 PRINT "PRESS ENTER TO EXIT"
9080 K$=INKEY$
9090 IF K$<>"" THEN GOTO 9080
9100 K$=INKEY$
9110 IF ASC(K$)=13 THEN END
9120 PAUSE .05
9130 GOTO 9100
