10 REM G5: MSX2 graphics integration and page isolation
20 SCREEN 5
30 COLOR 15,1,1
40 CLS
50 IF POINT(0,0)<>1 THEN PRINT "FAIL CLS": END
60 PSET (10,10),4
70 IF POINT(10,10)<>4 THEN PRINT "FAIL PSET": END
80 PRESET (10,10)
90 IF POINT(10,10)<>1 THEN PRINT "FAIL PRESET": END
100 LINE (20,20)-(50,50),3,BF
110 IF POINT(35,35)<>3 THEN PRINT "FAIL LINE BF": END
120 CIRCLE (90,70),20,6
130 IF POINT(110,70)<>6 THEN PRINT "FAIL CIRCLE": END
140 LINE (120,20)-(160,60),8,B
150 PAINT (140,40),9,8
160 IF POINT(140,40)<>9 THEN PRINT "FAIL PAINT": END
170 DRAW "BM180,20R10D10L10U10"
180 IF POINT(190,20)<>15 THEN PRINT "FAIL DRAW": END
190 COPY (20,20)-(50,50) TO (20,100)
200 IF POINT(35,115)<>3 THEN PRINT "FAIL COPY": END
210 SCREEN 5,,,1,0
220 IF POINT(35,35)<>0 THEN PRINT "FAIL PAGE ISOLATION": END
230 PSET (35,35),12
240 IF POINT(35,35)<>12 THEN PRINT "FAIL PAGE WRITE": END
250 CLS
260 IF POINT(35,35)<>1 THEN PRINT "FAIL PAGE CLS": END
270 SCREEN 5,,,0,0
280 IF POINT(35,35)<>3 THEN PRINT "FAIL PAGE PRESERVE": END
290 LOCATE 0,15
300 PRINT "GRAPHICS G5 PASS"
310 INPUT "Press any key to continue..."; A$
320 END
