10 REM CLINTER LIFE 720P - CONWAY GAME OF LIFE (1970)
20 REM SCREEN 20 / 1280X720 / 256 COLORS - FLAT ARRAYS
30 REM 1 GLIDER  2 R-PENTOMINO  3 BLINKERS  4 GOSPER GUN
40 REM SPACE PAUSE  N SINGLE STEP  R RESET  +/- SPEED  X EXIT
50 SCREEN 20,3
60 COLOR 255,0
70 CLS
80 W=80:H=44:S=12:OX=160:OY=170
90 DIM A(4000),B(4000)
100 PAT=4:GEN=0:POP=0:DELAY=.12:HALT=0:STEPON=0
110 GOSUB 1000
120 REM MAIN LOOP
130 K$=INKEY$
140 IF K$="X" OR K$="x" THEN GOTO 9000
145 IF K$<>"" THEN IF ASC(K$)=27 THEN GOTO 9000
150 IF K$=" " THEN HALT=1-HALT
160 IF K$="N" OR K$="n" THEN STEPON=1
170 IF K$="R" OR K$="r" THEN GOSUB 1000
180 IF K$="1" THEN PAT=1:GOSUB 1000
190 IF K$="2" THEN PAT=2:GOSUB 1000
200 IF K$="3" THEN PAT=3:GOSUB 1000
210 IF K$="4" THEN PAT=4:GOSUB 1000
220 IF K$="+" OR K$="=" THEN DELAY=DELAY/1.5
230 IF K$="-" THEN DELAY=DELAY*1.5
240 IF DELAY<.01 THEN DELAY=.01
250 IF DELAY>.8 THEN DELAY=.8
260 IF HALT=1 AND STEPON=0 THEN GOSUB 6000:PAUSE .04:GOTO 130
270 STEPON=0
280 GOSUB 3000
290 GOSUB 4000
300 GOSUB 6000
310 PAUSE DELAY
320 GOTO 130
1000 REM RESET WORLD AND LOAD PATTERN
1010 FOR Y=1 TO H+2
1020 FOR X=1 TO W+2
1030 A(((Y)-1)*82+(X))=0:B(((Y)-1)*82+(X))=0
1040 NEXT X
1050 NEXT Y
1060 GEN=0:POP=0:HALT=0:STEPON=0:DRAWNEXT=0
1070 CLS
1072 GOSUB 6500
1075 REM TWO-PIXEL FRAME OUTSIDE THE CELL AREA
1080 LINE (OX-3,OY-3)-(OX+W*S+2,OY-2),40,BF
1082 LINE (OX-3,OY+H*S+1)-(OX+W*S+2,OY+H*S+2),40,BF
1084 LINE (OX-3,OY-3)-(OX-2,OY+H*S+2),40,BF
1086 LINE (OX+W*S+1,OY-3)-(OX+W*S+2,OY+H*S+2),40,BF
1090 IF PAT=1 THEN GOSUB 2000
1100 IF PAT=2 THEN GOSUB 2100
1110 IF PAT=3 THEN GOSUB 2200
1120 IF PAT=4 THEN GOSUB 2300
1130 FOR Y=2 TO H+1
1140 FOR X=2 TO W+1
1150 IF A(((Y)-1)*82+(X))=1 THEN POP=POP+1:GOSUB 5000
1160 NEXT X
1170 NEXT Y
1180 GOSUB 6000
1190 RETURN
2000 REM GLIDER - NEAR CENTER
2010 A(((20)-1)*82+(41))=1:A(((21)-1)*82+(42))=1:A(((22)-1)*82+(40))=1
2020 A(((22)-1)*82+(41))=1:A(((22)-1)*82+(42))=1
2030 RETURN
2100 REM R-PENTOMINO - 1103 GENERATIONS TO STABILITY
2110 A(((21)-1)*82+(41))=1:A(((21)-1)*82+(42))=1:A(((22)-1)*82+(40))=1
2120 A(((22)-1)*82+(41))=1:A(((23)-1)*82+(41))=1
2130 RETURN
2200 REM THREE BLINKERS
2210 FOR I=36 TO 38:A(((18)-1)*82+(I))=1:NEXT I
2220 FOR I=22 TO 24:A(((I)-1)*82+(45))=1:NEXT I
2230 FOR I=41 TO 43:A(((29)-1)*82+(I))=1:NEXT I
2240 RETURN
2300 REM GOSPER GLIDER GUN - 36 LIVE CELLS
2310 REM COORDINATES ARE OFFSET TO LEFT-MIDDLE OF WORLD
2320 A(((19)-1)*82+(4))=1:A(((20)-1)*82+(4))=1:A(((19)-1)*82+(5))=1:A(((20)-1)*82+(5))=1
2330 A(((19)-1)*82+(14))=1:A(((20)-1)*82+(14))=1:A(((21)-1)*82+(14))=1
2340 A(((18)-1)*82+(15))=1:A(((22)-1)*82+(15))=1
2350 A(((17)-1)*82+(16))=1:A(((23)-1)*82+(16))=1
2360 A(((17)-1)*82+(17))=1:A(((23)-1)*82+(17))=1
2370 A(((20)-1)*82+(18))=1
2380 A(((18)-1)*82+(19))=1:A(((22)-1)*82+(19))=1
2390 A(((19)-1)*82+(20))=1:A(((20)-1)*82+(20))=1:A(((21)-1)*82+(20))=1
2400 A(((20)-1)*82+(21))=1
2410 A(((17)-1)*82+(24))=1:A(((18)-1)*82+(24))=1:A(((19)-1)*82+(24))=1
2420 A(((17)-1)*82+(25))=1:A(((18)-1)*82+(25))=1:A(((19)-1)*82+(25))=1
2430 A(((16)-1)*82+(26))=1:A(((20)-1)*82+(26))=1
2440 A(((15)-1)*82+(28))=1:A(((16)-1)*82+(28))=1:A(((20)-1)*82+(28))=1:A(((21)-1)*82+(28))=1
2450 A(((17)-1)*82+(38))=1:A(((18)-1)*82+(38))=1:A(((17)-1)*82+(39))=1:A(((18)-1)*82+(39))=1
2460 RETURN
3000 REM NEXT GENERATION - FIXED DEAD BOUNDARY
3010 FOR Y=2 TO H+1
3020 FOR X=2 TO W+1
3030 N=A(((Y-1)-1)*82+(X-1))+A(((Y-1)-1)*82+(X))+A(((Y-1)-1)*82+(X+1))
3040 N=N+A(((Y)-1)*82+(X-1))+A(((Y)-1)*82+(X+1))
3050 N=N+A(((Y+1)-1)*82+(X-1))+A(((Y+1)-1)*82+(X))+A(((Y+1)-1)*82+(X+1))
3060 B(((Y)-1)*82+(X))=0
3070 IF N=3 THEN B(((Y)-1)*82+(X))=1
3080 IF N=2 AND A(((Y)-1)*82+(X))=1 THEN B(((Y)-1)*82+(X))=1
3090 NEXT X
3100 NEXT Y
3110 RETURN
4000 REM UPDATE ONLY CHANGED PIXELS
4010 POP=0:DRAWNEXT=1
4020 FOR Y=2 TO H+1
4030 FOR X=2 TO W+1
4040 IF A(((Y)-1)*82+(X))<>B(((Y)-1)*82+(X)) THEN GOSUB 5000
4050 A(((Y)-1)*82+(X))=B(((Y)-1)*82+(X))
4060 POP=POP+A(((Y)-1)*82+(X))
4070 NEXT X
4080 NEXT Y
4090 GEN=GEN+1:DRAWNEXT=0
4100 RETURN
5000 REM DRAW ONE CELL: CURRENT B(((Y)-1)*82+(X)) STATE
5010 PX=OX+(X-2)*S:PY=OY+(Y-2)*S
5020 C=0
5030 IF DRAWNEXT=0 AND A(((Y)-1)*82+(X))=1 THEN C=28
5040 IF DRAWNEXT=1 AND B(((Y)-1)*82+(X))=1 THEN C=28
5050 LINE (PX,PY)-(PX+S-2,PY+S-2),C,BF
5060 RETURN
6000 REM REFRESH ONLY STATUS TEXT BELOW FIXED INSTRUCTIONS
6010 LINE (0,112)-(1279,159),0,BF
6020 LOCATE 2,8
6030 PRINT "GENERATION:";GEN;"  POPULATION:";POP;"  PATTERN:";PAT
6040 LOCATE 2,9
6050 IF HALT=1 THEN PRINT "PAUSED   (N = ONE STEP)" ELSE PRINT "RUNNING"
6060 RETURN
6500 REM STATIC HEADER - DRAW ONCE AFTER CLS
6510 LOCATE 2,1
6520 PRINT "CLINTER 720P  -  CONWAY'S GAME OF LIFE  (1970)"
6530 LOCATE 2,3
6540 PRINT "1 GLIDER  2 R-PENTOMINO  3 BLINKERS  4 GOSPER GUN"
6550 LOCATE 2,5
6560 PRINT "SPACE PAUSE  N STEP  R RESET  +/- SPEED  X/ESC EXIT"
6570 RETURN
9000 REM CLEAN EXIT
9010 CLS
9020 LOCATE 2,2
9030 PRINT "CONWAY'S GAME OF LIFE - END"
9040 LOCATE 2,4
9050 PRINT "GENERATIONS:";GEN;"  FINAL POPULATION:";POP
9060 LOCATE 2,7
9070 PRINT "PRESS ENTER TO EXIT"
9080 K$=INKEY$
9090 IF K$<>"" THEN GOTO 9080
9100 K$=INKEY$
9110 IF K$<>"" THEN IF ASC(K$)=13 THEN END
9120 PAUSE .05
9130 GOTO 9100
