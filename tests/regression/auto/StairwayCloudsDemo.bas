10 REM STAIRWAY INTO THE CLOUDS - ONE BUILD, SYNCHRONIZED TO MUSIC
20 REM ORIGINAL THREE VOICE SYNTH MUSIC; ESC STOPS; ENTER EXITS
30 SCREEN 7,2
40 COLOR 15,1
50 CLS
60 FOR S=1 TO 30
70 X=(S*73) MOD 510
80 Y=(S*41) MOD 165
90 PSET (X,Y),15
100 NEXT S
110 LINE (0,174)-(511,211),1,BF
120 FOR C=0 TO 7
130 CIRCLE (C*75,175),26,9
140 NEXT C
150 LOCATE 1,0
160 PRINT "STAIRWAY INTO THE CLOUDS"
170 REM LONG ORIGINAL ARPEGGIO; THREE VOICES
180 PLAY BACKGROUND "T108 O4 V11 Q7 L8 A C E A >C E D C <A E C A G B D G A C E A >C E D C <A E C A G B D G A C E A >C E D C <A E C A G B D G", "T108 O3 V8 Q8 L4 A E F E G D E E A E F E G D E E A E F E G D E E", "T108 O2 V7 Q8 L2 A F G E A F G E A F G E"
190 REM BUILD FROM LAND (WIDE BOTTOM STEP) UP TO SKY (NARROW TOP STEP)
200 K=0
210 PLAY PROGRESS P
220 T=INT(P*16/100)
230 IF T>16 THEN T=16
240 IF K>=T THEN 310
250 K=K+1
260 Y=62+(17-K)*8
270 W=12+(17-K)*27
280 IF W>506 THEN W=506
290 LINE (INT(256-W/2),Y)-(INT(256+W/2),Y+5),14,BF
300 GOTO 240
310 A$=INKEY$
320 IF ASC(A$)=27 THEN 600
330 IF P>=100 THEN 380
340 PAUSE .03
350 GOTO 210
360 REM FILL REMAINING STEPS WHEN MUSIC ENDS OR ESC IS PRESSED
380 IF K>=16 THEN 440
390 K=K+1
400 Y=62+(17-K)*8
410 W=12+(17-K)*27
420 LINE (INT(256-W/2),Y)-(INT(256+W/2),Y+5),14,BF
430 GOTO 380
440 LOCATE 1,2
450 PRINT "Press Enter to exit"
460 A$=INKEY$
470 IF ASC(A$)=13 THEN 500
480 PAUSE .04
490 GOTO 460
500 END
600 PLAY STOP
610 GOTO 380
