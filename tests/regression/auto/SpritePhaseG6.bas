10 REM G6.1 - three independent sprite patterns and movement
20 SCREEN 5,0
30 COLOR 15,0
40 CLS
50 SPRITE$(0)="<<<||<<<"
60 SPRITE$(1)="~~<<>>~~"
70 SPRITE$(2)="XXffXXff"
80 PUT SPRITE 0,(25,35),3,0
90 PUT SPRITE 1,(105,70),10,1
100 PUT SPRITE 2,(190,115),14,2
110 PRINT "G6.1 THREE SPRITES - DIFFERENT POSITIONS"
120 FOR I=1 TO 80
130 PUT SPRITE 0,(25+I,35),3,0
140 PUT SPRITE 1,(105,70+I),10,1
150 NEXT I
160 PRINT "G6.1 SPRITE MOVEMENT PASS"
170 INPUT "Press any key to continue..."; A$
180 END
