10 REM MAT READ - DATA ORDER, CURSOR SHARING, AND MULTIPLE ARRAYS
20 DIM A(2,2),B(2),C(2)
30 DATA 11,12,21,22,31,32,41,42
40 MAT READ A,B
50 READ X,Y
60 IF A(0,0)<>11 THEN PRINT "FAIL MAT READ A00":END
70 IF A(0,1)<>12 THEN PRINT "FAIL MAT READ A01":END
80 IF A(1,0)<>21 THEN PRINT "FAIL MAT READ A10":END
90 IF A(1,1)<>22 THEN PRINT "FAIL MAT READ A11":END
100 IF B(0)<>31 THEN PRINT "FAIL MAT READ B0":END
110 IF B(1)<>32 THEN PRINT "FAIL MAT READ B1":END
120 IF X<>41 THEN PRINT "FAIL MAT READ CURSOR X":END
130 IF Y<>42 THEN PRINT "FAIL MAT READ CURSOR Y":END
140 RESTORE
150 MAT READ C
160 IF C(0)<>11 THEN PRINT "FAIL MAT READ RESTORE 0":END
170 IF C(1)<>12 THEN PRINT "FAIL MAT READ RESTORE 1":END
180 PRINT "MAT READ PASS"
190 END
