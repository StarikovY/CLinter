10 REM D1 DUCK HUNT - INTERACTIVE MSX2 GAME
20 REM GRAPHICS WINDOW: SPACE/I FIRE, X/ESC QUIT
30 SCREEN 7,1
40 COLOR 15,1
50 CLS
60 REM 16X16 SPRITES SELECTED BY SCREEN 7,1
61 SPRITE$(0)=HEX$("000000000000187CFFFE7F3F1F070300001E3F371E0F1F3F7F7FFEFCF8E03000")
70 SPRITE$(1)=HEX$("0101010100000000000000000000000080808080000000000000000000000000")
80 SH=0: HIT=0: SCORE=0: B=0: BX=248: BY=169
90 X=20: Y=110: DX=5: T=0: LV=1: N=0
100 GOSUB 8000
110 PUT SPRITE 0,(X,Y),10,0
120 PLAY BACKGROUND "T170 O4 L8 C E G >C <G E C G", "T170 O3 L4 C G A G", "T170 O2 L2 C G"
150 REM MAIN GAME LOOP; SPRITES MOVE WITHOUT CLEARING SCENE
160 T=T+1
170 K$=INKEY$
180 IF K$="X" OR K$="x" THEN GOTO 7000
190 IF ASC(K$)=27 THEN GOTO 7000
200 IF K$="I" OR K$="i" OR K$=" " THEN GOSUB 6000
210 X=X+DX
220 IF X>480 THEN DX=-5-LV
230 IF X<12 THEN DX=5+LV
240 IF T<65 THEN Y=112
250 IF T>=65 AND T<100 THEN Y=112-(T-65)*2
260 IF T>=100 AND T<205 THEN Y=42
270 IF T>=205 AND T<240 THEN Y=42+(T-205)*2
280 IF T>=240 THEN Y=112
290 PUT SPRITE 0,(X,Y),10,0
300 IF B=1 THEN GOSUB 5000
310 IF T>=280 THEN T=0
320 PAUSE .018
330 GOTO 150
5000 REM BULLET AND COLLISION
5010 BY=BY-13
5020 IF BY<20 THEN B=0: PUT SPRITE 1: RETURN
5030 PUT SPRITE 1,(BX,BY),15,1
5040 IF BX>=X-4 AND BX<=X+18 AND BY>=Y-4 AND BY<=Y+18 THEN GOSUB 6500
5050 RETURN
6000 REM SHOOT: SINGLE BULLET IN FLIGHT
6010 IF B=1 THEN RETURN
6020 SH=SH+1: B=1: BX=248: BY=169
6030 PUT SPRITE 1,(BX,BY),15,1
6040 BEEP
6050 RETURN
6500 REM HIT: FALLING DUCK, SCORE, NEXT ROUND
6510 B=0: HIT=HIT+1: SCORE=SCORE+100
6520 PUT SPRITE 1
6530 PLAY BACKGROUND "T220 O4 L16 G F D O3 B G", "T220 O3 L16 C R G R C"
6540 FY=Y: FX=X
6550 FOR F=1 TO 18
6560 FY=FY+6: FX=INT(FX+DX/6)
6570 IF FY>126 THEN FY=126
6580 IF FX<4 THEN FX=4
6590 IF FX>490 THEN FX=490
6600 PUT SPRITE 0,(FX,FY),10,0
6610 PAUSE .035
6620 IF FY>=126 THEN GOTO 6640
6630 NEXT F
6640 PUT SPRITE 0
6650 LV=1+INT(HIT/3)
6660 IF LV>5 THEN LV=5
6670 X=20: Y=112: DX=5+LV: T=0
6680 PUT SPRITE 0,(X,Y),10,0
6690 RETURN
7000 REM GAME OVER: WAIT FOR NEW KEY, LEAVE WINDOW VISIBLE
7010 PLAY STOP
7020 PUT SPRITE 0
7030 PUT SPRITE 1
7040 CLS
7050 LOCATE 2,2
7060 PRINT "DUCK HUNT D1 - GAME OVER"
7070 LOCATE 2,5
7080 PRINT "SHOTS FIRED:"; SH
7090 LOCATE 2,7
7100 PRINT "DUCKS HIT: "; HIT
7110 LOCATE 2,9
7120 PRINT "SCORE:     "; SCORE
7130 LOCATE 2,11
7140 PRINT "LEVEL:     "; LV
7150 LOCATE 2,14
7160 PRINT "PRESS ENTER TO EXIT"
7170 K$=INKEY$
7180 IF K$<>"" THEN GOTO 7170
7190 K$=INKEY$
7200 IF ASC(K$)=13 THEN END
7210 PAUSE .05
7220 GOTO 7190
8000 REM STATIC SCENE
8010 LINE (0,0)-(511,211),1,BF
8020 LINE (0,142)-(511,211),4,BF
8030 LINE (0,142)-(511,143),9
8040 LINE (0,180)-(511,180),9
8050 LINE (247,194)-(265,211),6,BF
8060 CIRCLE (256,189),5,10
8070 LINE (253,181)-(259,184),6,BF
8080 LINE (255,173)-(257,190),15,BF
8090 LOCATE 1,0
8100 PRINT "DUCK HUNT D1   SCREEN 7"
8110 LOCATE 1,1
8120 PRINT "SPACE/I: FIRE   X/ESC: EXIT"
8130 RETURN
