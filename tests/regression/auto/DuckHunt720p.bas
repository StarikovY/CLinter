7130 LOCATE 2,11
7140 PRINT "LEVEL:     "; LV
7150 LOCATE 2,14
7160 PRINT "PRESS ENTER TO EXIT"
7170 K$=INKEY$
7180 IF K$<>"" THEN GOTO 7170
7190 K$=INKEY$
7200 IF ASC(K$)=13 THEN END
7210 PAUSE .05
7220 GOTO 7190
