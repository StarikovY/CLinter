150 REM MAIN GAME LOOP; SPRITES MOVE WITHOUT CLEARING SCENE
160 NOW=CLOCK(): DT=NOW-LAST: LAST=NOW: IF DT<0 THEN DT=0
165 IF DT>.1 THEN DT=.1
166 T=T+DT
170 K$=INKEY$
180 IF K$="X" OR K$="x" THEN GOTO 7000
190 IF ASC(K$)=27 THEN GOTO 7000
195 IF ASC(K$)=28 THEN A=A-9: IF A< -90 THEN A=-90
196 IF ASC(K$)=29 THEN A=A+9: IF A>90 THEN A=90
197 IF ASC(K$)=28 OR ASC(K$)=29 THEN GOSUB 8700
200 IF K$="I" OR K$="i" OR K$=" " THEN GOSUB 6000
210 X=X+DX*DT
220 IF X>1235 THEN X=1235: N=N+1: DX=-(67+266*(N-3*INT(N/3)))
230 IF X<12 THEN X=12: N=N+1: DX=67+266*(N-3*INT(N/3))
240 IF T<2.925 THEN Y=380
250 IF T>=2.925 AND T<4.5 THEN Y=380-(T-2.925)*133.3333
260 IF T>=4.5 AND T<9.225 THEN Y=170
270 IF T>=9.225 AND T<10.8 THEN Y=170+(T-9.225)*133.3333
280 IF T>=10.8 THEN Y=380
290 GOSUB 8500
300 IF B=1 THEN GOSUB 5000
310 IF T>=12.6 THEN T=0
320 PAUSE .045
330 GOTO 150
5000 REM BULLET AND COLLISION
5010 OBX=BX: OBY=BY: BX=BX+VX*DT: BY=BY+VY*DT
5020 IF BY<35 OR BX<0 OR BX>1260 OR BY>710 THEN B=0: PUT SPRITE 10: RETURN
5030 PUT SPRITE 10,(INT(BX+.5),INT(BY+.5)),255,10
5040 REM SWEPT SEGMENT VS DUCK BOUNDING BOX; BULLET TIP AT BX+14,BY
5041 IF BY<=Y+32 AND OBY>=Y AND BX+16>=X AND BX+14<=X+32 THEN GOSUB 6500
5050 RETURN
6000 REM SHOOT ALONG AIM ANGLE; SPRITE PIXEL OFFSET +14
6010 IF B=1 THEN RETURN
6020 SH=SH+1: B=1: R=A*PI/180: BX=INT(640+70*SIN(R)+.5)-14: BY=INT(620-70*COS(R)+.5): VX=600*SIN(R): VY=-600*COS(R)
6030 PUT SPRITE 10,(INT(BX+.5),INT(BY+.5)),255,10
6040 BEEP
6050 RETURN
6500 REM HIT: FALLING DUCK, SCORE, NEXT ROUND
6510 B=0: HIT=HIT+1: SCORE=SCORE+100
6520 PUT SPRITE 10
6530 PLAY BACKGROUND "T220 O4 L16 G F D O3 B G", "T220 O3 L16 C R G R C"
6540 FY=Y: FX=X
6550 FALLLAST=CLOCK()
6551 FOR F=1 TO 80
6552 FALLNOW=CLOCK(): FDT=FALLNOW-FALLLAST: FALLLAST=FALLNOW
6553 IF FDT<0 THEN FDT=0
6554 IF FDT>.1 THEN FDT=.1
6560 FY=FY+400*FDT: FX=FX+DX*FDT/6
6570 IF FY>495 THEN FY=495
6580 IF FX<4 THEN FX=4
6590 IF FX>1235 THEN FX=1235
6600 X=FX: Y=FY: GOSUB 8500
6610 PAUSE .035
6620 IF FY>=495 THEN GOTO 6640
6630 NEXT F
6640 PUT SPRITE 0: PUT SPRITE 2: PUT SPRITE 4: PUT SPRITE 6: PUT SPRITE 8
6650 LV=1+INT(HIT/3)
6660 IF LV>5 THEN LV=5
6670 X=40: Y=380: N=N+1: DX=67+266*(N-3*INT(N/3)): T=0: LAST=CLOCK()
6680 GOSUB 8500
6690 RETURN
7000 REM GAME OVER: WAIT FOR NEW KEY, LEAVE WINDOW VISIBLE
7010 PLAY STOP
7020 PUT SPRITE 0: PUT SPRITE 2: PUT SPRITE 4: PUT SPRITE 6: PUT SPRITE 8
7030 PUT SPRITE 10
7040 COLOR 0,207: CLS
