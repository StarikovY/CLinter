10 REM R2 PRINT zones, separators, TAB, and statement chaining
20 PRINT "START PrZones"
30 PRINT "A";"B"
40 PRINT "A","B"
50 PRINT "12345678901234","B"
60 PRINT TAB(5);"X"
70 PRINT "AB";TAB(8);"C"
80 PRINT "LEFT";
90 PRINT "RIGHT"
100 PRINT "ONE"; : PRINT "TWO"
110 PRINT "ONE", : PRINT "TWO"
120 PRINT
130 PRINT "END PrZones"
